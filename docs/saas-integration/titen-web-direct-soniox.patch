+import { beforeEach, expect, it, vi } from 'vitest'
+import { eq } from 'drizzle-orm'
+import { transcriptionSessions, user } from '#/db/schema'
+import { creditTopup, getBalance } from '#/lib/ledger'
+import {
+  authorizeDirectSession,
+  endDirectSession,
+  reconcileDirectSessions,
+} from '#/lib/transcription/direct'
+import { finalizeSession, persistSegment } from '#/lib/transcription/service'
+import { createTestDb, uniqueKey, type TestDb } from './helpers/db'
+
+let db: TestDb
+beforeEach(async () => {
+  db = createTestDb()
+  await db.insert(user).values({
+    id: 'direct-user',
+    name: 'Direct',
+    email: 'direct@example.com',
+    emailVerified: true,
+    createdAt: new Date(),
+    updatedAt: new Date(),
+  })
+  await creditTopup(db, {
+    accountId: 'direct-user',
+    units: 10_000,
+    idempotencyKey: uniqueKey('direct'),
+  })
+})
+const input = { accountId: 'direct-user', deviceSessionId: 'direct-device' }
+function mint() {
+  return vi
+    .fn<typeof fetch>()
+    .mockResolvedValue(
+      Response.json(
+        { api_key: 'temporary-test-key', expires_at: new Date(Date.now() + 60_000).toISOString() },
+        { status: 201 },
+      ),
+    )
+}
+async function usage(sessionId: string, audioMs = 60_000) {
+  return Response.json({
+    usage_logs: [
+      {
+        uuid: `usage-${sessionId}`,
+        client_reference_id: sessionId,
+        input_audio_duration_ms: audioMs,
+        model: 'stt-rt-v5',
+        end_time: new Date().toISOString(),
+      },
+    ],
+    next_page_cursor: null,
+  })
+}
+it('reserves the full allowance and mints one restricted provider credential', async () => {
+  const fetcher = mint()
+  const grant = await authorizeDirectSession(db, input, 'server-secret', fetcher)
+  expect(grant.maxSessionDurationSeconds).toBe(3600)
+  expect(grant.wsUrl).toBe('wss://stt-rt.soniox.com/transcribe-websocket')
+  expect(grant.temporaryApiKey).toBe('temporary-test-key')
+  expect(await getBalance(db, input.accountId)).toEqual({ available: 0, reserved: 10_000 })
+  const [url, init] = fetcher.mock.calls[0]
+  expect(url).toBe('https://api.soniox.com/v1/auth/temporary-api-key')
+  expect(JSON.parse(init!.body as string)).toEqual({
+    usage_type: 'transcribe_websocket',
+    expires_in_seconds: 60,
+    single_use: true,
+    max_session_duration_seconds: 3600,
+    client_reference_id: grant.sessionId,
+  })
+  const [row] = await db.select().from(transcriptionSessions)
+  expect(JSON.stringify(row)).not.toContain('temporary-test-key')
+})
+it('rejects missing provider configuration before reserving credit', async () => {
+  await expect(authorizeDirectSession(db, input, undefined)).rejects.toMatchObject({ status: 503 })
+  expect((await getBalance(db, input.accountId)).reserved).toBe(0)
+})
+it('keeps the hold when minting times out because issuance is uncertain', async () => {
+  const fetcher = vi.fn<typeof fetch>().mockRejectedValue(new Error('timeout'))
+  await expect(authorizeDirectSession(db, input, 'server-secret', fetcher)).rejects.toMatchObject({
+    status: 503,
+  })
+  expect((await getBalance(db, input.accountId)).reserved).toBe(10_000)
+})
+it('client end and direct calls to finalization cannot release unverified usage', async () => {
+  const grant = await authorizeDirectSession(db, input, 'server-secret', mint())
+  await endDirectSession(db, grant.sessionId)
+  await finalizeSession(db, grant.sessionId)
+  await endDirectSession(db, grant.sessionId)
+  expect((await getBalance(db, input.accountId)).reserved).toBe(10_000)
+})
+it('empty usage records retain the hold even after client end', async () => {
+  const grant = await authorizeDirectSession(db, input, 'server-secret', mint())
+  await endDirectSession(db, grant.sessionId)
+  const fetcher = vi
+    .fn<typeof fetch>()
+    .mockResolvedValue(Response.json({ usage_logs: [], next_page_cursor: null }))
+  expect(await reconcileDirectSessions(db, 'server-secret', fetcher)).toEqual({
+    checked: 1,
+    reconciled: 0,
+    pending: 1,
+  })
+  expect((await getBalance(db, input.accountId)).reserved).toBe(10_000)
+})
+it('paginates provider records and settles observed usage exactly once', async () => {
+  const grant = await authorizeDirectSession(db, input, 'server-secret', mint())
+  const fetcher = vi
+    .fn<typeof fetch>()
+    .mockResolvedValueOnce(Response.json({ usage_logs: [], next_page_cursor: 'page-2' }))
+    .mockResolvedValueOnce(await usage(grant.sessionId))
+  expect((await reconcileDirectSessions(db, 'server-secret', fetcher)).reconciled).toBe(1)
+  expect(new URL(fetcher.mock.calls[1][0] as URL).searchParams.get('cursor')).toBe('page-2')
+  expect(await getBalance(db, input.accountId)).toEqual({ available: 9833, reserved: 0 })
+  await reconcileDirectSessions(db, 'server-secret', fetcher)
+  expect(await getBalance(db, input.accountId)).toEqual({ available: 9833, reserved: 0 })
+  const [row] = await db
+    .select()
+    .from(transcriptionSessions)
+    .where(eq(transcriptionSessions.id, grant.sessionId))
+  expect(row.acceptedAudioMs).toBe(60_000)
+  expect(row.state).toBe('closed')
+})
+it('unrelated provider records cannot release a reservation', async () => {
+  await authorizeDirectSession(db, input, 'server-secret', mint())
+  const fetcher = vi.fn<typeof fetch>().mockResolvedValue(await usage('another-session'))
+  expect((await reconcileDirectSessions(db, 'server-secret', fetcher)).reconciled).toBe(0)
+  expect((await getBalance(db, input.accountId)).reserved).toBe(10_000)
+})
+it('concurrent authorizations cannot spend the same available balance', async () => {
+  const results = await Promise.allSettled([
+    authorizeDirectSession(db, input, 'server-secret', mint()),
+    authorizeDirectSession(db, input, 'server-secret', mint()),
+  ])
+  expect(results.filter((result) => result.status === 'fulfilled')).toHaveLength(1)
+  expect(await getBalance(db, input.accountId)).toEqual({ available: 0, reserved: 10_000 })
+})
+
+it('replayed transcript uploads create one segment and one Google document job', async () => {
+  const grant = await authorizeDirectSession(db, input, 'server-secret', mint())
+  const segment = {
+    accountId: input.accountId,
+    meetingId: grant.meetingId,
+    seq: 1,
+    text: 'Meeting note',
+    speaker: '1',
+    startMs: 100,
+    endMs: 800,
+  }
+  expect(await persistSegment(db, segment)).toBe(true)
+  expect(await persistSegment(db, segment)).toBe(false)
+  const { transcriptSegments, docJobs } = await import('#/db/schema')
+  expect(await db.select().from(transcriptSegments)).toHaveLength(1)
+  expect(await db.select().from(docJobs)).toHaveLength(1)
+})
+
+it('a definitive mint rejection releases credit without issuing a usable grant', async () => {
+  const fetcher = vi.fn<typeof fetch>().mockResolvedValue(new Response(null, { status: 401 }))
+  await expect(authorizeDirectSession(db, input, 'invalid-key', fetcher)).rejects.toMatchObject({
+    status: 503,
+  })
+  expect(await getBalance(db, input.accountId)).toEqual({ available: 10_000, reserved: 0 })
+})
+
+it('rotates pending checks so missing logs cannot starve later sessions', async () => {
+  const { authorizeSession } = await import('#/lib/transcription/service')
+  const grants = []
+  await creditTopup(db, {
+    accountId: input.accountId,
+    units: 1_000_000,
+    idempotencyKey: uniqueKey('rotation'),
+  })
+  for (let i = 0; i < 101; i++) {
+    const grant = await authorizeSession(db, input)
+    await db
+      .update(transcriptionSessions)
+      .set({ provider: 'soniox', state: 'finalizing' })
+      .where(eq(transcriptionSessions.id, grant.sessionId))
+    grants.push(grant)
+  }
+  const fetcher = vi
+    .fn<typeof fetch>()
+    .mockResolvedValue(Response.json({ usage_logs: [], next_page_cursor: null }))
+  await reconcileDirectSessions(db, 'server-key', fetcher)
+  const unchecked = await db.select().from(transcriptionSessions)
+  const last = unchecked.find((session) => session.lastReconcileCheck === null)!
+  fetcher.mockResolvedValue(await usage(last.id))
+  expect((await reconcileDirectSessions(db, 'server-key', fetcher)).reconciled).toBe(1)
+})
