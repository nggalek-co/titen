+import { beforeEach, expect, it, vi } from 'vitest'
+vi.mock('cloudflare:workers', () => ({ env: {} }))
+import { eq } from 'drizzle-orm'
+import { z } from 'zod'
+import { transcriptSegments, transcriptionSessions, user } from '#/db/schema'
+import { creditTopup } from '#/lib/ledger'
+import { authorizeDirectSession } from '#/lib/transcription/direct'
+import { createTestDb, uniqueKey, type TestDb } from './helpers/db'
+
+const harness = vi.hoisted(() => ({
+  database: (): TestDb => {
+    throw new Error('database not initialized')
+  },
+  post: async (_input: { request: Request }): Promise<Response> => {
+    throw new Error('route not loaded')
+  },
+}))
+vi.mock('@tanstack/react-router', () => ({
+  createFileRoute: () => (options: { server: { handlers: { POST: typeof harness.post } } }) => {
+    harness.post = options.server.handlers.POST
+    return options
+  },
+}))
+vi.mock('#/db', () => ({ getDb: () => harness.database() }))
+vi.mock('#/lib/device-auth', () => ({
+  requireDevice: async () => ({ userId: 'sync-user', deviceSessionId: 'sync-device' }),
+}))
+vi.mock('#/lib/api-auth', () => ({
+  jsonError: (error: unknown) => {
+    throw error
+  },
+  parseJson: async (request: Request, schema: { parse: (body: unknown) => unknown }) =>
+    schema.parse(await request.json()),
+}))
+let db: TestDb
+let sessionId: string
+beforeEach(async () => {
+  db = createTestDb()
+  harness.database = () => db
+  await db.insert(user).values({
+    id: 'sync-user',
+    name: 'Sync',
+    email: 'sync@example.com',
+    emailVerified: true,
+    createdAt: new Date(),
+    updatedAt: new Date(),
+  })
+  await creditTopup(db, {
+    accountId: 'sync-user',
+    units: 10_000,
+    idempotencyKey: uniqueKey('sync'),
+  })
+  const fetcher = vi
+    .fn<typeof fetch>()
+    .mockResolvedValue(
+      Response.json({ api_key: 'temp', expires_at: new Date(Date.now() + 60_000).toISOString() }),
+    )
+  sessionId = (
+    await authorizeDirectSession(
+      db,
+      { accountId: 'sync-user', deviceSessionId: 'sync-device' },
+      'server-key',
+      fetcher,
+    )
+  ).sessionId
+  await import('#/routes/api/heartbeat')
+})
+function post(segments?: unknown[]) {
+  return harness.post({
+    request: new Request('http://localhost/api/heartbeat', {
+      method: 'POST',
+      body: JSON.stringify({ sessionId, segments }),
+    }),
+  })
+}
+it('counts this session grant in the displayed budget and accepts replayed transcript batches', async () => {
+  const segments = [{ seq: 1, text: 'Notes', speaker: '1', startMs: 0, endMs: 1000 }]
+  const body = z
+    .object({ ok: z.boolean(), secondsLeft: z.number() })
+    .parse(await (await post(segments)).json())
+  expect(body.ok).toBe(true)
+  expect(body.secondsLeft).toBeGreaterThan(3590)
+  await post(segments)
+  expect(await db.select().from(transcriptSegments)).toHaveLength(1)
+  const [row] = await db.select().from(transcriptionSessions)
+  expect(row.acceptedAudioMs).toBe(0)
+})
+it('another device cannot upload segments to this session', async () => {
+  await db
+    .update(transcriptionSessions)
+    .set({ deviceSessionId: 'another-device' })
+    .where(eq(transcriptionSessions.id, sessionId))
+  await expect(post([{ seq: 1, text: 'Forged' }])).rejects.toMatchObject({ status: 404 })
+  expect(await db.select().from(transcriptSegments)).toHaveLength(0)
+})
+it('rejects oversized batches before writing segments', async () => {
+  await expect(
+    post(Array.from({ length: 101 }, (_, i) => ({ seq: i + 1, text: 'text' }))),
+  ).rejects.toBeDefined()
+  expect(await db.select().from(transcriptSegments)).toHaveLength(0)
+})
+
+it('accepts final transcript sync after provider reconciliation has closed billing', async () => {
+  await db
+    .update(transcriptionSessions)
+    .set({ state: 'closed', providerUsageId: 'completed-provider-record' })
+    .where(eq(transcriptionSessions.id, sessionId))
+  const synced = await (await post([{ seq: 1, text: 'Last words' }])).json()
+  expect(synced).toMatchObject({ ok: true })
+  expect(await db.select().from(transcriptSegments)).toHaveLength(1)
+  expect(await (await post()).json()).toMatchObject({ ok: false, reason: 'session_closed' })
+})
+
+it('acknowledges final transcript uploads while billing awaits reconciliation', async () => {
+  await db
+    .update(transcriptionSessions)
+    .set({ state: 'finalizing' })
+    .where(eq(transcriptionSessions.id, sessionId))
+  expect(await (await post([{ seq: 1, text: 'Final note' }])).json()).toMatchObject({ ok: true })
+  expect(await db.select().from(transcriptSegments)).toHaveLength(1)
+  expect(await (await post()).json()).toMatchObject({ ok: false, reason: 'session_closed' })
+})
