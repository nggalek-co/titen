+import { createFileRoute } from '@tanstack/react-router'
+import { env } from 'cloudflare:workers'
+import { getDb } from '#/db'
+import { jsonError } from '#/lib/api-auth'
+import { HttpError } from '#/lib/errors'
+import { reconcileDirectSessions } from '#/lib/transcription/direct'
+
+export const Route = createFileRoute('/api/internal/transcription-usage')({
+  server: {
+    handlers: {
+      POST: async ({ request }) => {
+        try {
+          const token = env.TRANSCRIPTION_RECONCILE_TOKEN
+          if (!token || request.headers.get('Authorization') !== `Bearer ${token}`)
+            throw new HttpError(401, 'service authorization required')
+          return Response.json(await reconcileDirectSessions(getDb(), env.SONIOX_API_KEY))
+        } catch (error) {
+          return jsonError(error)
+        }
+      },
+    },
+  },
+})
