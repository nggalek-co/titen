diff --git a/src/lib/transcription/direct.ts b/src/lib/transcription/direct.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/transcription/direct.ts
@@ -0,0 +1,233 @@
+import { and, asc, eq, inArray, isNull, sql } from 'drizzle-orm'
+import { z } from 'zod'
+
+import type { Database } from '#/db'
+import { transcriptionSessions } from '#/db/schema'
+import { HttpError } from '#/lib/errors'
+import { getBalance, release } from '#/lib/ledger'
+import { TRANSCRIPTION_RATE_UNITS_PER_HOUR } from '#/lib/payments/pricing'
+import { authorizeSession, chargeUnitsForAudioMs, finalizeSession } from './service'
+
+export const SONIOX_WS_URL = 'wss://stt-rt.soniox.com/transcribe-websocket'
+const MAX_DURATION_SECONDS = 18_000
+const KEY_TTL_SECONDS = 60
+const credential = z.object({ api_key: z.string().min(1), expires_at: z.iso.datetime() })
+const usagePage = z.object({
+  usage_logs: z.array(
+    z.object({
+      uuid: z.string().min(1),
+      client_reference_id: z.string().nullable().optional(),
+      input_audio_duration_ms: z.number().int().nonnegative(),
+      model: z.string(),
+      end_time: z.iso.datetime(),
+    }),
+  ),
+  next_page_cursor: z.string().nullable().optional(),
+})
+export const uploadedSegment = z
+  .object({
+    seq: z.number().int().positive(),
+    text: z.string().min(1).max(20_000),
+    speaker: z.string().max(100).optional(),
+    startMs: z.number().int().nonnegative().optional(),
+    endMs: z.number().int().nonnegative().optional(),
+  })
+  .refine(
+    (s) => s.startMs === undefined || s.endMs === undefined || s.endMs >= s.startMs,
+    'endMs must not precede startMs',
+  )
+
+export async function authorizeDirectSession(
+  db: Database,
+  input: { accountId: string; deviceSessionId: string; clientTag?: string },
+  apiKey: string | undefined,
+  fetcher: typeof fetch = fetch,
+) {
+  if (!apiKey?.trim()) throw new HttpError(503, 'transcription provider is not configured')
+  await reconcileDirectSessions(db, apiKey, fetcher, { accountId: input.accountId })
+  const balance = await getBalance(db, input.accountId)
+  const seconds = Math.min(
+    MAX_DURATION_SECONDS,
+    Math.floor((balance.available * 3600) / TRANSCRIPTION_RATE_UNITS_PER_HOUR),
+  )
+  if (seconds < 600) throw new HttpError(402, 'insufficient credit: need ten minutes minimum')
+  const session = await authorizeSession(db, {
+    ...input,
+    reservationUnits: chargeUnitsForAudioMs(seconds * 1000, TRANSCRIPTION_RATE_UNITS_PER_HOUR),
+  })
+  // Persist liability before minting. A timeout can hide a successfully issued key.
+  await db
+    .update(transcriptionSessions)
+    .set({
+      provider: 'soniox',
+      keyExpiresAt: new Date(Date.now() + KEY_TTL_SECONDS * 1000),
+      maxSessionDurationSeconds: seconds,
+    })
+    .where(eq(transcriptionSessions.id, session.sessionId))
+  let response: Response
+  try {
+    response = await fetcher('https://api.soniox.com/v1/auth/temporary-api-key', {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        usage_type: 'transcribe_websocket',
+        expires_in_seconds: KEY_TTL_SECONDS,
+        single_use: true,
+        max_session_duration_seconds: seconds,
+        client_reference_id: session.sessionId,
+      }),
+      signal: AbortSignal.timeout(15_000),
+    })
+  } catch {
+    throw new HttpError(503, 'temporary key unavailable; reserved credit awaits reconciliation')
+  }
+  if (!response.ok) {
+    if ([400, 401, 403, 429].includes(response.status)) {
+      await release(db, {
+        reservationId: session.reservationId,
+        accountId: input.accountId,
+        idempotencyKey: `session:${session.sessionId}:release`,
+      })
+      await db
+        .update(transcriptionSessions)
+        .set({ state: 'failed' })
+        .where(
+          and(
+            eq(transcriptionSessions.id, session.sessionId),
+            eq(transcriptionSessions.state, 'authorizing'),
+          ),
+        )
+    }
+    throw new HttpError(503, 'temporary key rejected by provider')
+  }
+  const parsed = credential.safeParse(await response.json().catch(() => null))
+  if (!parsed.success) throw new HttpError(503, 'invalid temporary credential response')
+  const expiresAt = new Date(parsed.data.expires_at)
+  if (expiresAt.getTime() <= Date.now() || expiresAt.getTime() > Date.now() + 120_000)
+    throw new HttpError(503, 'invalid temporary credential expiry')
+  await db
+    .update(transcriptionSessions)
+    .set({ state: 'active', keyExpiresAt: expiresAt })
+    .where(
+      and(
+        eq(transcriptionSessions.id, session.sessionId),
+        eq(transcriptionSessions.state, 'authorizing'),
+      ),
+    )
+  return {
+    ...session,
+    wsUrl: SONIOX_WS_URL,
+    temporaryApiKey: parsed.data.api_key,
+    expiresAt: expiresAt.toISOString(),
+    maxSessionDurationSeconds: seconds,
+    model: 'stt-rt-v5',
+  }
+}
+
+export async function endDirectSession(db: Database, sessionId: string) {
+  await db
+    .update(transcriptionSessions)
+    .set({ state: 'finalizing' })
+    .where(
+      and(
+        eq(transcriptionSessions.id, sessionId),
+        eq(transcriptionSessions.provider, 'soniox'),
+        inArray(transcriptionSessions.state, ['authorizing', 'active', 'reconnecting']),
+      ),
+    )
+}
+
+export async function reconcileDirectSessions(
+  db: Database,
+  apiKey: string | undefined,
+  fetcher: typeof fetch = fetch,
+  scope: { accountId?: string; sessionId?: string } = {},
+) {
+  if (!apiKey?.trim()) throw new HttpError(503, 'transcription provider is not configured')
+  const sessions = await db
+    .select()
+    .from(transcriptionSessions)
+    .where(
+      and(
+        eq(transcriptionSessions.provider, 'soniox'),
+        scope.accountId ? eq(transcriptionSessions.accountId, scope.accountId) : undefined,
+        scope.sessionId ? eq(transcriptionSessions.id, scope.sessionId) : undefined,
+        inArray(transcriptionSessions.state, ['authorizing', 'active', 'finalizing']),
+      ),
+    )
+    .orderBy(asc(transcriptionSessions.lastReconcileCheck), asc(transcriptionSessions.id))
+    .limit(100)
+  let reconciled = 0
+  const pending = new Map(sessions.map((session) => [session.id, session]))
+  for (const session of sessions) {
+    await db
+      .update(transcriptionSessions)
+      .set({
+        lastReconcileCheck: sql`(SELECT coalesce(max(last_reconcile_check), 0) + 1 FROM transcription_sessions)`,
+      })
+      .where(eq(transcriptionSessions.id, session.id))
+    if (session.providerUsageId) {
+      await finalizeSession(db, session.id)
+      reconciled++
+      pending.delete(session.id)
+    }
+  }
+  const endTime = new Date()
+  const startTime = new Date(
+    Math.max(
+      Math.min(...sessions.map((session) => session.createdAt.getTime())) - 1000,
+      endTime.getTime() - 31 * 86400_000,
+    ),
+  )
+  let cursor: string | undefined
+  const seen = new Set<string>()
+  for (let page = 0; page < 100 && pending.size > 0; page++) {
+    const url = new URL('https://api.soniox.com/v1/usage-logs')
+    url.searchParams.set('start_time', startTime.toISOString())
+    url.searchParams.set('end_time', endTime.toISOString())
+    url.searchParams.set('limit', '1000')
+    if (cursor) url.searchParams.set('cursor', cursor)
+    const response = await fetcher(url, {
+      headers: { Authorization: `Bearer ${apiKey}` },
+      signal: AbortSignal.timeout(15_000),
+    })
+    if (!response.ok)
+      throw new HttpError(503, 'provider usage unavailable; credit remains reserved')
+    const parsed = usagePage.safeParse(await response.json().catch(() => null))
+    if (!parsed.success) throw new HttpError(503, 'invalid provider usage response')
+    for (const entry of parsed.data.usage_logs) {
+      const session = entry.client_reference_id ? pending.get(entry.client_reference_id) : undefined
+      if (
+        !session ||
+        !entry.model.startsWith('stt-') ||
+        new Date(entry.end_time).getTime() < session.createdAt.getTime()
+      )
+        continue
+      await db
+        .update(transcriptionSessions)
+        .set({
+          providerUsageId: entry.uuid,
+          acceptedAudioMs: entry.input_audio_duration_ms,
+          state: 'finalizing',
+        })
+        .where(
+          and(
+            eq(transcriptionSessions.id, session.id),
+            isNull(transcriptionSessions.providerUsageId),
+            inArray(transcriptionSessions.state, ['authorizing', 'active', 'finalizing']),
+          ),
+        )
+      await finalizeSession(db, session.id)
+      reconciled++
+      pending.delete(session.id)
+    }
+    const next = parsed.data.next_page_cursor
+    if (!next) break
+    if (seen.has(next)) throw new HttpError(503, 'provider usage pagination repeated')
+    if (page === 99 && pending.size > 0)
+      throw new HttpError(503, 'provider usage pagination limit reached; credit remains reserved')
+    seen.add(next)
+    cursor = next
+  }
+  return { checked: sessions.length, reconciled, pending: sessions.length - reconciled }
+}
